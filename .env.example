PORT=3000
DATABASE_URL=postgresql://postgres:password@db:5432/phonemail
AUTH_TOKEN_SECRET=
TWO_FACTOR_API_KEY=
TWO_FACTOR_OTP_TEMPLATE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio-owned SMS-capable sender number in E.164 format
TWILIO_PHONE_NUMBER=
TWILIO_TRIAL_MODE=false
TWILIO_TRIAL_PHONE_NUMBER=
TWILIO_TRIAL_WEBHOOK_KEY=
TWILIO_REGISTRATION_NUMBER=
TWILIO_TOLL_FREE_NUMBER=
# Public HTTPS URL ending in /api/auth, e.g. https://example.ngrok-free.app/api/auth
TWILIO_WEBHOOK_BASE_URL=
# Local-only simulated IVR. Never enable for an internet-facing deployment.
IVR_DEMO_MODE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-address@gmail.com
# Gmail requires an App Password when 2-Step Verification is enabled.
APP_BASE_URL=http://localhost:3000
