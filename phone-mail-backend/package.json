{
  "name": "phone-mail-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PhoneMail backend and web/mobile UI shell",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
