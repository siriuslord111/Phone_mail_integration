// Prisma schema: User, Alias, Conversation, and Message models will be defined here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                     @id @default(uuid())
  phoneNumber          String                     @unique
  email                String                     @unique
  passwordHash         String? // Argon2id hash for password fallback accounts
  aliasIds             String[]                   @default([])
  language             String                     @default("en")
  profilePic           String?
  name                 String?
  bio                  String?
  hasMobileApp         Boolean                    @default(false) // Used to determine if SMS notifications are needed[cite: 1]
  smsNotificationsEnabled Boolean                  @default(false)
  conversations        Conversation[]
  inboundEmails        InboundEmail[]
  mailMessages         MailMessage[]
  contactNicknames     ContactNickname[]
  drafts               MailDraft[]
  groupMemberships     GroupChatMember[]
  sentGroupMessages    GroupChatMessage[]
  deletedGroupMessages GroupChatMessageDeletion[]
  createdAt            DateTime                   @default(now())
}

model ContactNickname {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  nickname  String
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
  @@index([userId])
}

model Conversation {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  contactEmail String // The other party in the 1-to-1 or group chat
  isGroup      Boolean   @default(false)
  messages     Message[]
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  subject        String // Compact Subject field[cite: 1]
  body           String
  isIncoming     Boolean // True if received, False if sent (Unified inbox/sent[cite: 1])
  isRead         Boolean      @default(false)
  isFavorited    Boolean      @default(false)
  hasAttachments Boolean      @default(false)
  replyToId      String? // Links to original email[cite: 1]
  createdAt      DateTime     @default(now())
}

model InboundEmail {
  id                String   @id @default(uuid())
  providerMessageId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAddress       String
  toAddress         String
  subject           String
  body              String
  receivedAt        DateTime
  mailbox           String   @default("inbox")
  isRead            Boolean  @default(false)
  isStarred         Boolean  @default(false)
  repliedAt         DateTime?

  @@unique([providerMessageId, userId])
  @@index([userId, receivedAt])
}

model MailMessage {
  id          String           @id @default(uuid())
  messageId   String
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  peerAddress String
  fromAddress String
  toAddress   String
  subject     String
  body        String
  direction   String
  mailbox     String           @default("inbox")
  isRead      Boolean          @default(false)
  isStarred   Boolean          @default(false)
  repliedAt   DateTime?
  replyToId   String?
  quotedText  String?
  createdAt   DateTime         @default(now())
  attachments MailAttachment[]

  @@unique([messageId, userId])
  @@index([userId, peerAddress, createdAt])
}

model MailAttachment {
  id            String      @id @default(uuid())
  mailMessageId String
  mailMessage   MailMessage @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  size          Int
  content       Bytes
  createdAt     DateTime    @default(now())

  @@index([mailMessageId])
}

model MailDraft {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients  String[]
  subject     String                 @default("")
  body        String                 @default("")
  updatedAt   DateTime               @updatedAt
  attachments MailDraftAttachment[]

  @@index([userId, updatedAt])
}

model MailDraftAttachment {
  id        String   @id @default(uuid())
  draftId   String
  draft     MailDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime @default(now())

  @@index([draftId])
}

model GroupChat {
  id          String             @id @default(uuid())
  name        String             @default("")
  description String             @default("")
  avatarUrl   String             @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     GroupChatMember[]
  messages    GroupChatMessage[]
}

model GroupChatMember {
  id          String    @id @default(uuid())
  groupChatId String
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt  DateTime?
  isFavourite Boolean   @default(false)

  @@unique([groupChatId, userId])
  @@index([userId, groupChatId])
}

model GroupChatMessage {
  id          String                     @id @default(uuid())
  groupChatId String
  groupChat   GroupChat                  @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  subject     String                     @default("")
  body        String
  replyToId   String?
  repliedAt   DateTime?
  isStarred   Boolean                    @default(false)
  createdAt   DateTime                   @default(now())
  attachments GroupChatAttachment[]
  deletions   GroupChatMessageDeletion[]

  @@index([groupChatId, createdAt])
}

model GroupChatMessageDeletion {
  id        String           @id @default(uuid())
  messageId String
  message   GroupChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime         @default(now())

  @@unique([messageId, userId])
  @@index([userId, messageId])
}

model GroupChatAttachment {
  id        String           @id @default(uuid())
  messageId String
  message   GroupChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  content   Bytes

  @@index([messageId])
}
